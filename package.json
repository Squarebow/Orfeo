{
  "name": "orfeo",
  "version": "0.5.0",
  "description": "Modern piano learning app with MIDI visualization",
  "author": "SquareBow",
  "license": "MIT",
  "main": "out/main/main.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "dist": "electron-vite build && electron-builder"
  },
  "build": {
    "appId": "com.squarebow.orfeo",
    "productName": "Orfeo",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": "dmg",
      "icon": "public/icon.icns"
    }
  },
  "dependencies": {
    "@tonejs/midi": "^2.0.28",
    "jazz-midi-electron": "^2.0.3",
    "jzz": "^1.9.6",
    "jzz-midi-smf": "^1.9.9",
    "jzz-synth-tiny": "^1.4.4",
    "pixi.js": "^8.0.0",
    "soundfont-player": "^0.12.0",
    "tonal": "^6.4.0",
    "tone": "^15.1.22",
    "webaudiofont": "^3.0.4",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.2",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.1.0",
    "lucide-react": "^0.503.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.8.3"
  }
}
