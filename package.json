{
  "name": "orfeo",
  "version": "1.5.4",
  "description": "Modern piano learning app with MIDI visualization",
  "author": "SquareBow",
  "license": "SEE LICENSE IN LICENSE.md",
  "main": "out/main/main.js",
  "type": "module",
  "scripts": {
    "copyworklet": "node -e \"const fs=require('fs');fs.copyFileSync('node_modules/spessasynth_lib/dist/spessasynth_processor.min.js','public/spessasynth_processor.min.js')\"",
    "check:hand-engine": "node scripts/check-hand-engine-version.mjs",
    "dev": "npm run copyworklet && npm run check:hand-engine && electron-vite dev",
    "build": "npm run copyworklet && npm run check:hand-engine && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "dist": "npm run copyworklet && npm run check:hand-engine && npm run native:build && electron-vite build && electron-builder --win nsis portable appx",
    "dist:portable": "npm run copyworklet && npm run check:hand-engine && npm run native:build && electron-vite build --mode test-build && electron-builder --win portable",
    "release:notes": "node scripts/release-notes.mjs",
    "native:build": "node scripts/build-native.mjs",
    "i18n:extract": "node scripts/i18n-extract.mjs"
  },
  "build": {
    "appId": "com.squarebow.orfeo",
    "productName": "Orfeo",
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "Squarebow",
      "repo": "Orfeo"
    },
    "files": [
      "out/**/*",
      "!out/renderer/images/**/*",
      "!out/renderer/fonts/**/*",
      "!out/renderer/Demo/**/*",
      "!out/renderer/icon.ico",
      "!node_modules/**/*",
      "node_modules/pdfkit/**/*",
      "node_modules/@noble/**/*",
      "node_modules/fontkit/**/*",
      "node_modules/js-md5/**/*",
      "node_modules/linebreak/**/*",
      "node_modules/png-js/**/*",
      "node_modules/@swc/helpers/**/*",
      "node_modules/brotli/**/*",
      "node_modules/clone/**/*",
      "node_modules/dfa/**/*",
      "node_modules/fast-deep-equal/**/*",
      "node_modules/restructure/**/*",
      "node_modules/tiny-inflate/**/*",
      "node_modules/unicode-properties/**/*",
      "node_modules/unicode-trie/**/*",
      "node_modules/base64-js/**/*",
      "node_modules/browserify-zlib/**/*",
      "node_modules/pako/**/*",
      "node_modules/tslib/**/*",
      "!**/*.map",
      "!**/*.d.ts",
      "!**/*.d.mts",
      "!**/*.d.cts"
    ],
    "extraResources": [
      {
        "from": "public/fonts",
        "to": "fonts"
      },
      {
        "from": "public/demo",
        "to": "demo"
      },
      {
        "from": "native/build",
        "to": "native",
        "filter": [
          "orfeo_audio.node",
          "fluidsynth/*.dll"
        ]
      }
    ],
    "asarUnpack": [
      "out/renderer/spessasynth_processor.min.js",
      "out/renderer/GeneralUser-GS.sf2"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "appx",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.ico"
    },
    "appx": {
      "minVersion": "10.0.17763.0",
      "applicationId": "Orfeo",
      "identityName": "Squarebow.Orfeo",
      "publisher": "CN=0D175E82-5309-4021-B6EE-10D4D85601F5",
      "publisherDisplayName": "Squarebow",
      "artifactName": "Orfeo-${version}.${ext}",
      "showNameOnTiles": true
    },
    "nsis": {
      "artifactName": "Orfeo-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico",
      "installerHeader": "build/installerHeader.bmp",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "include": "build/installer.nsh",
      "license": "build/license.txt"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "mac": {
      "target": "dmg",
      "icon": "public/icon.icns"
    }
  },
  "dependencies": {
    "@coderline/alphatab": "^1.8.4",
    "@tonejs/midi": "^2.0.28",
    "electron-updater": "^6.8.9",
    "fuse.js": "^7.5.0",
    "gsap": "^3.15.0",
    "jazz-midi-electron": "^2.0.3",
    "jzz": "^1.9.6",
    "jzz-midi-smf": "^1.9.9",
    "jzz-synth-tiny": "^1.4.4",
    "midi-file": "^1.2.4",
    "pdfkit": "^0.20.2",
    "pixi-filters": "^6.1.5",
    "pixi.js": "^8.22.0",
    "soundfont-player": "^0.12.0",
    "spessasynth_core": "^4.3.22",
    "spessasynth_lib": "^4.3.13",
    "tonal": "^6.4.0",
    "tone": "^15.1.22",
    "wasm-media-encoders": "^0.7.0",
    "webaudiofont": "^3.0.4",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.5.2",
    "electron": "^44.9.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.1.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.8.3"
  }
}
